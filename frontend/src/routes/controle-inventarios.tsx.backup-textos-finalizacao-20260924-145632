type FiltroTipo = "TODOS" | TipoInventario;

type FiltroPendencias =
  | "TODAS"
  | "COM_PENDENCIAS"
  | "SEM_PENDENCIAS";

type FiltroPeriodo =
  | "QUALQUER"
  | "HOJE"
  | "ULTIMOS_7_DIAS"
  | "ULTIMOS_30_DIAS"
  | "ESTE_MES"
  | "PERSONALIZADO";

function rotuloFaseFiltro(valor: string) {
  const rotulos: Record<string, string> = {
    DEFINIR_ESCOPO: "Definir escopo",
    AGUARDANDO_CONTAGEM: "Aguardando contagem",
    AGUARDANDO_RECONTAGEM: "Aguardando recontagem",
    EM_RECONTAGEM: "Em recontagem",
    PROXIMA_RODADA_DISPONIVEL: "Proxima rodada disponivel",
    EM_CONTAGEM: "Em contagem",
    AGUARDANDO_GESTOR: "Aguardando gestor",
    AGUARDANDO_DECISAO: "Aguardando decisão",
    RECONTAGEM_PENDENTE: "Recontagem pendente",
    PRONTO_FINALIZAR: "Pronto para finalizar",
    PRONTO_PARA_FINALIZAR: "Pronto para finalizar",
    FINALIZADO: "Finalizado",
    CANCELADO: "Cancelado",
  };

  if (rotulos[valor]) {
    return rotulos[valor];
  }

  const texto = valor
    .toLocaleLowerCase("pt-BR")
    .replace(/_/g, " ");

  return (
    texto.charAt(0).toLocaleUpperCase("pt-BR") +
    texto.slice(1)
  );
}

const STATUS_INVENTARIO_TERMINAIS = new Set(["FINALIZADO", "ENCERRADO", "CANCELADO"]);

function normalizarTexto(valor: string | null | undefined): string {
  return String(valor ?? "")
    .trim()
    .toUpperCase();
}

function clienteEhOperacional(
  cliente: string | null | undefined,
): boolean {
  const nome = normalizarTexto(cliente);

  return (
    nome.includes("ENDRESS+HAUSER") ||
    nome === "UM GRAU E MEIO"
  );
}


function estaAguardandoGestor(inventario: InventarioResumo): boolean {
  return (
    inventario.tipo === "OFICIAL" &&
    inventario.em_analise_gestor &&
    !STATUS_INVENTARIO_TERMINAIS.has(normalizarTexto(inventario.status))
  );
}

function possuiResultadoFinal(inventario: InventarioResumo): boolean {
  return (
    inventario.tipo === "OFICIAL" &&
    normalizarTexto(inventario.status) === "FINALIZADO"
  );
}

