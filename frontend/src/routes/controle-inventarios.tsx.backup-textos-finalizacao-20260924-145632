                    {clientesDisponiveis.map((cliente) => (
                      <option
                        key={`${cliente.cliente_id}-${cliente.armazem}`}
                        value={`${cliente.cliente_id}|${cliente.armazem}`}
                      >
                        {cliente.cliente}
                      </option>
                    ))}
                  </select>
                </Campo>

                <Campo label="Armazém">
                  <input
                    required
                    maxLength={60}
                    value={formulario.armazem}
                    readOnly
                    aria-readonly="true"
                    placeholder="Preenchido automaticamente"
                    className={`${inputClass} bg-muted/40`}
                    disabled={salvando}
                  />
                </Campo>

                {inventarioAtivoNoArmazem && (
                  <div className="sm:col-span-2 rounded-lg border border-amber-500/40 bg-amber-500/10 px-4 py-3">
                    <p className="text-sm font-semibold text-amber-800 dark:text-amber-300">
                      Armazém indisponível
                    </p>

                    <p className="mt-1 text-sm text-amber-800/90 dark:text-amber-200">
                      O armazém{" "}
                      <strong>{formulario.armazem.trim().toUpperCase()}</strong>{" "}
                      já possui o inventário{" "}
                      <strong>
                        {inventarioAtivoNoArmazem.codigo_inventario}
                      </strong>{" "}
                      em andamento, com status{" "}
                      <strong>{inventarioAtivoNoArmazem.status}</strong>.
                      Finalize ou cancele esse inventário antes de criar outro.
                    </p>

                    {inventariosAtivosNoArmazem.length > 1 && (
                      <p className="mt-2 text-xs text-amber-800/80 dark:text-amber-200/80">
                        Existem mais {inventariosAtivosNoArmazem.length - 1}{" "}
                        inventário(s) ativo(s) neste armazém.
                      </p>
                    )}

                    <Link
                      to="/inventarios/$idInventario"
                      params={{
                        idInventario: String(
                          inventarioAtivoNoArmazem.id_inventario,
                        ),
                      }}
                      className="mt-3 inline-flex text-sm font-semibold text-amber-900 underline underline-offset-4 dark:text-amber-200"
                    >
                      Abrir inventário{" "}
                      {inventarioAtivoNoArmazem.codigo_inventario}
                    </Link>
                  </div>
                )}

                {formulario.tipo === "ROTATIVO" && (
                  <div className="sm:col-span-2 rounded-lg border border-border bg-muted/20 p-4">
                    <div className="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                      <div>
                        <p className="text-sm font-semibold text-foreground">
                          Ciclo Rotativo obrigatório
                        </p>

                        {!formulario.cliente_id ? (
                          <p className="mt-1 text-sm text-muted-foreground">
                            Selecione um cliente para consultar o ciclo
                            rotativo.
                          </p>
                        ) : consultandoCiclo ? (
                          <p className="mt-1 text-sm text-muted-foreground">
                            Consultando ciclo rotativo...
                          </p>
                        ) : cicloRotativo ? (
                          <div className="mt-2 space-y-1 text-sm">
                            <p className="font-medium text-foreground">
                              {cicloRotativo.codigo_ciclo}
                            </p>

                            <p className="text-muted-foreground">
                              Status: {cicloRotativo.status}
                            </p>

                            <p className="text-muted-foreground">
                              Cobertura: {cicloRotativo.percentual_cobertura}%
                              {" · "}
                              Total: {cicloRotativo.total_localizacoes}
                              {" · "}
                              Pendentes:{" "}
                              {cicloRotativo.resumo_localizacoes?.pendentes ??
                                Math.max(
                                  cicloRotativo.total_localizacoes -
                                    cicloRotativo.localizacoes_contadas,
                                  0,
                                )}
                            </p>
                          </div>
                        ) : (
                          <p className="mt-1 text-sm text-muted-foreground">
                            Nenhum ciclo rotativo aberto para este cliente e
                            armazém.
                          </p>
                        )}
                      </div>

                      <div className="flex flex-wrap gap-2">
                        {formulario.cliente_id &&
                          formulario.armazem &&
                          !consultandoCiclo &&
                          !consultandoUniverso &&
                          !cicloRotativo &&
                          universoRotativo &&
                          !universoRotativo.sincronizado && (
                            <Button
                              type="button"
                              variant="outline"
                              onClick={() => {
                                void sincronizarUniversoDoFormulario();
                              }}
                              disabled={
                                sincronizandoUniverso ||
                                abrindoCiclo ||
                                salvando
                              }
                            >
                              {sincronizandoUniverso
                                ? "Sincronizando..."
                                : universoRotativo.configurado
                                  ? "Sincronizar universo"
                                  : "Configurar universo"}
                            </Button>
                          )}

                        {formulario.cliente_id &&
                          formulario.armazem &&
                          !consultandoCiclo &&
                          !consultandoUniverso &&
                          !cicloRotativo &&
                          universoRotativo?.sincronizado && (
                            <Button
                              type="button"
                              variant="outline"
                              onClick={() => {
                                void abrirCicloDoFormulario();
                              }}
                              disabled={
                                abrindoCiclo ||
                                sincronizandoUniverso ||
                                salvando
                              }
                            >
                              {abrindoCiclo
                                ? "Abrindo ciclo..."
                                : "Abrir Ciclo Rotativo"}
                            </Button>
                          )}
                      </div>
                    </div>

                    {formulario.cliente_id && formulario.armazem && (
                      <div className="mt-4 border-t border-border pt-3">
                        <p className="text-sm font-semibold text-foreground">
                          Universo rotativo
                        </p>

                        {consultandoUniverso ? (
                          <p className="mt-1 text-sm text-muted-foreground">
                            Consultando universo rotativo...
                          </p>
                        ) : erroUniverso ? (
                          <div className="mt-2 rounded-md border border-destructive/30 bg-destructive/5 px-3 py-2 text-sm text-destructive">
                            {erroUniverso}
                          </div>
                        ) : universoRotativo ? (
                          <div className="mt-2 space-y-1 text-sm">
                            <p className="text-muted-foreground">
                              Estoque atual:{" "}
                              {universoRotativo.total_localizacoes_estoque}
                              {" · "}
                              Cadastro mestre:{" "}
                              {universoRotativo.total_localizacoes_mestre}
                            </p>

                            <p className="text-muted-foreground">
                              Ativas:{" "}
                              {universoRotativo.total_localizacoes_ativas}
                              {" · "}
                              Inativas:{" "}
                              {universoRotativo.total_localizacoes_inativas}
                            </p>

                            <p className="text-muted-foreground">
                              Novas localizações:{" "}
                              {universoRotativo.total_novas_localizacoes}
                              {" · "}
                              Fora do estoque atual:{" "}
                              {universoRotativo.total_fora_estoque_atual}
                            </p>

                            <p className="font-medium text-foreground">
                              Status:{" "}
                              {universoRotativo.sincronizado
                                ? "Sincronizado"
                                : "Requer sincronização"}
                            </p>

                            {!universoRotativo.sincronizado &&
                              universoRotativo.possui_ciclo_aberto && (
                                <p className="text-sm text-muted-foreground">
                                  A sincronização do universo fica bloqueada
                                  enquanto existir um ciclo rotativo aberto.
                                </p>
                              )}
                          </div>
                        ) : (
                          <p className="mt-1 text-sm text-muted-foreground">
                            Universo rotativo não consultado.
                          </p>
                        )}
                      </div>
                    )}

                    {erroCiclo && (
                      <div className="mt-3 rounded-md border border-destructive/30 bg-destructive/5 px-3 py-2 text-sm text-destructive">
                        {erroCiclo}
                      </div>
                    )}
                  </div>
                )}

                <Campo label="Descrição">
                  <input
                    maxLength={255}
                    value={formulario.descricao}
                    onChange={(evento) =>
                      atualizarCampo("descricao", evento.target.value)
                    }
                    placeholder="Opcional"
                    className={inputClass}
                    disabled={salvando}
                  />
                </Campo>
              </div>

              {erroFormulario && (
                <div className="mx-5 mb-4 rounded-md border border-destructive/30 bg-destructive/5 px-4 py-3 text-sm text-destructive">
                  {erroFormulario}
                </div>
              )}

              <div className="flex justify-end gap-2 border-t border-border px-5 py-4">
                <Button
                  type="button"
                  variant="outline"
                  onClick={fecharModal}
                  disabled={salvando}
                >
                  Cancelar
                </Button>

                <Button
                  type="submit"
                  disabled={
                    salvando ||
                    Boolean(inventarioAtivoNoArmazem) ||
                    abrindoCiclo ||
                    consultandoCiclo ||
                    (formulario.tipo === "ROTATIVO" && !cicloRotativo)
                  }
                >
                  {salvando ? "Criando..." : "Criar inventário"}
                </Button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}

function prioridadeFase(fase: string) {
  const prioridades: Record<string, number> = {
    AGUARDANDO_GESTOR: 0,
    AGUARDANDO_DECISAO: 0,
    RECONTAGEM_PENDENTE: 1,
    AGUARDANDO_RECONTAGEM: 1,
    EM_RECONTAGEM: 1,
    PROXIMA_RODADA_DISPONIVEL: 2,
    PRONTO_FINALIZAR: 2,
    RODADA_CONCLUIDA: 3,
    EM_CONTAGEM: 4,
    AGUARDANDO_CONTAGEM: 5,
    DEFINIR_ESCOPO: 6,
    FINALIZADO: 7,
    CANCELADO: 8,
  };

  return prioridades[fase] ?? 99;
}

function formatarFase(fase: string) {
  const rotulos: Record<string, string> = {
    DEFINIR_ESCOPO: "Definir escopo",
    AGUARDANDO_CONTAGEM: "Aguardando contagem",
    AGUARDANDO_RECONTAGEM: "Aguardando recontagem",
    EM_RECONTAGEM: "Em recontagem",
    PROXIMA_RODADA_DISPONIVEL: "Proxima rodada disponivel",
    EM_CONTAGEM: "Em contagem",
    AGUARDANDO_GESTOR: "Aguardando gestor",
    AGUARDANDO_DECISAO: "Aguardando decis\u00e3o",
    RECONTAGEM_PENDENTE: "Recontagem pendente",
    PRONTO_FINALIZAR: "Pronto para finalizar",
    RODADA_CONCLUIDA: "Revisar rodada",
    FINALIZADO: "Finalizado",
    CANCELADO: "Cancelado",
  };

  return rotulos[fase] ?? formatarStatus(fase);
}

