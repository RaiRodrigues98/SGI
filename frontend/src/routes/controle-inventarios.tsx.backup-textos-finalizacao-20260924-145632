function ProgressoInventario({
  inventario,
}: {
  inventario: InventarioResumo;
}) {
  const percentual = Math.max(
    0,
    Math.min(
      100,
      Number(inventario.percentual_progresso) || 0,
    ),
  );

  if (inventario.total_localizacoes === 0) {
    return (
      <div className="min-w-0 text-xs text-muted-foreground">
        {"Escopo ainda n\u00e3o definido"}
      </div>
    );
  }

  return (
    <div className="w-full min-w-0 space-y-1.5">
      <div className="flex items-center justify-between gap-3 text-xs">
        <span className="font-medium text-foreground">
          {inventario.localizacoes_concluidas}/
          {inventario.total_localizacoes}
        </span>

        <span className="text-muted-foreground">
          {percentual.toLocaleString("pt-BR", {
            maximumFractionDigits: 1,
          })}
          %
        </span>
      </div>

      <div className="h-2 overflow-hidden rounded-full bg-muted">
        <div
          className="h-full rounded-full bg-primary transition-all"
          style={{ width: `${percentual}%` }}
        />
      </div>
    </div>
  );
}

function PendenciasInventario({
  inventario,
}: {
  inventario: InventarioResumo;
}) {
  if (inventario.total_localizacoes === 0) {
    return (
      <span className="text-xs text-muted-foreground">
        {"Definir localiza\u00e7\u00f5es"}
      </span>
    );
  }

  if (
    inventario.localizacoes_pendentes === 0 &&
    inventario.localizacoes_em_contagem === 0
  ) {
    return (
      <span className="text-xs font-medium text-emerald-700">
        {"Sem pend\u00eancias"}
      </span>
    );
  }

  return (
    <div className="space-y-1 text-xs">
      {inventario.localizacoes_pendentes > 0 && (
        <div className="font-medium text-amber-700 dark:text-amber-300">
          {inventario.localizacoes_pendentes} aguardando
        </div>
      )}

      {inventario.localizacoes_em_contagem > 0 && (
        <div className="font-medium text-violet-700 dark:text-violet-300">
          {inventario.localizacoes_em_contagem} em contagem
        </div>
      )}
    </div>
  );
}

function DivergenciasInventario({
  inventario,
}: {
  inventario: InventarioResumo;
}) {
  const faseTerminal = [
    "FINALIZADO",
    "CANCELADO",
  ].includes(inventario.fase_operacional);

  if (faseTerminal) {
    return (
      <span className="text-xs text-muted-foreground">
        {"\u2014"}
      </span>
    );
  }

  if (!inventario.analise_disponivel) {
    let mensagem = "Dispon?vel ap?s a rodada";

    if (inventario.total_localizacoes === 0) {
      mensagem = "Aguardando escopo";
    } else if (
      inventario.localizacoes_pendentes > 0 ||
      inventario.localizacoes_em_contagem > 0
    ) {
      mensagem = "Após concluir a contagem";
    }

    return (
      <span className="max-w-40 whitespace-normal text-xs text-muted-foreground">
        {mensagem}
      </span>
    );
  }

  if (inventario.total_divergencias === 0) {
    return (
      <span className="text-xs font-medium text-emerald-700 dark:text-emerald-300">
        {"Sem diverg\u00eancias"}
      </span>
    );
  }

  return (
    <div className="min-w-0 space-y-1 text-xs">
      <div className="font-semibold text-destructive">
        {inventario.total_divergencias}
      </div>

      {inventario.recontagens_pendentes > 0 && (
        <div className="font-medium text-violet-700 dark:text-violet-300">
          {inventario.recontagens_pendentes}{" "}
          em recontagem
        </div>
      )}

      {inventario.divergencias_justificadas > 0 && (
        <div className="font-medium text-emerald-700 dark:text-emerald-300">
          {inventario.divergencias_justificadas}{" "}
          justificadas
        </div>
      )}

      {inventario.pode_finalizar && (
        <div className="font-semibold text-emerald-700 dark:text-emerald-300">
          Pronto para finalizar
        </div>
      )}
    </div>
  );
}

function rotuloProximaAcao(acao: string) {
  const rotulos: Record<string, string> = {
    DEFINIR_LOCALIZACOES: "Definir escopo",
    INICIAR_CONTAGEM: "Iniciar contagem",
    CONTINUAR_CONTAGEM: "Continuar contagem",
    ACOMPANHAR_RECONTAGEM: "Acompanhar recontagem",
    GERAR_PROXIMA_RODADA: "Gerar proxima rodada",
    ANALISAR_GESTOR: "Analisar",
    ANALISAR_ROTATIVO: "Analisar divergências",
    GERAR_RECONTAGEM: "Gerar recontagem",
    FINALIZAR_INVENTARIO: "Finalizar",
    REVISAR_RODADA: "Revisar rodada",
    CONSULTAR_RESULTADO: "Ver resultado",
    CONSULTAR_INVENTARIO: "Consultar",
  };

  return rotulos[acao] ?? "Abrir";
}

function AcaoInventario({
  inventario,
  podeExecutarContagem,
}: {
  inventario: InventarioResumo;
  podeExecutarContagem: boolean;
}) {
  const tipoOficial = inventario.tipo === "OFICIAL";
  const acao = inventario.proxima_acao;

  if (tipoOficial && !STATUS_INVENTARIO_TERMINAIS.has(normalizarTexto(inventario.status)) &&
      (acao === "ANALISAR_GESTOR" || estaAguardandoGestor(inventario))) {
    return (
      <Button asChild size="sm">
        <Link to="/analise-gestor" search={{ inventario: inventario.id_inventario }}>
          <ShieldCheck aria-hidden="true" />
          Analisar
        </Link>
      </Button>
    );
  }

  if (tipoOficial && (acao === "CONSULTAR_RESULTADO" || possuiResultadoFinal(inventario))) {
    return (
      <Button asChild size="sm" variant="outline">
        <Link to="/analise-gestor" search={{ inventario: inventario.id_inventario }}>
          <BarChart3 aria-hidden="true" />
          Ver resultado
        </Link>
      </Button>
    );
  }

  if (!tipoOficial && ["ANALISAR_ROTATIVO", "GERAR_RECONTAGEM", "FINALIZAR_INVENTARIO", "REVISAR_RODADA"].includes(acao)) {
    return (
      <Button asChild size="sm">
        <Link to="/analise-ciclica" search={{ inventario: inventario.id_inventario }}>
          <Eye aria-hidden="true" />
          {rotuloProximaAcao(acao)}
        </Link>
      </Button>
    );
  }

  if (tipoOficial && acao === "FINALIZAR_INVENTARIO") {
    return (
      <Button asChild size="sm">
        <Link to="/analise-gestor" search={{ inventario: inventario.id_inventario }}>
          <ShieldCheck aria-hidden="true" />
          Finalizar
        </Link>
      </Button>
    );
  }

  if (tipoOficial && acao === "REVISAR_RODADA") {
    return (
      <Button asChild size="sm">
        <Link to="/analise-oficial" search={{ inventario: inventario.id_inventario }}>
          <Eye aria-hidden="true" />
          Revisar rodada
        </Link>
      </Button>
    );
  }

  if (tipoOficial && acao === "GERAR_RECONTAGEM") {
    return (
      <Button asChild size="sm">
        <Link to="/inventarios/$idInventario/controle-rodadas" params={{ idInventario: String(inventario.id_inventario) }}>
          <Eye aria-hidden="true" />
          Gerar recontagem
        </Link>
      </Button>
    );
  }

  if (
    inventario.proxima_acao ===
    "ACOMPANHAR_RECONTAGEM"
  ) {
    return (
      <Button asChild size="sm">
        <Link
          to="/recontagem"
          search={{
            inventario: inventario.id_inventario,
          }}
        >
          <Eye aria-hidden="true" />
          Acompanhar recontagem
        </Link>
      </Button>
    );
  }

  if (
    inventario.proxima_acao ===
    "GERAR_PROXIMA_RODADA"
  ) {
    return inventario.tipo === "OFICIAL" ? (
      <Button asChild size="sm">
        <Link
          to="/inventarios/$idInventario/controle-rodadas"
          params={{
            idInventario: String(inventario.id_inventario),
          }}
        >
          <Eye aria-hidden="true" />
          Gerar proxima rodada
        </Link>
      </Button>
    ) : (
      <Button asChild size="sm">
        <Link
          to="/analise-ciclica"
          search={{ inventario: inventario.id_inventario }}
        >
          <Eye aria-hidden="true" />
          Analisar divergências
        </Link>
      </Button>
    );
  }

  if (
    !podeExecutarContagem &&
    [
      "INICIAR_CONTAGEM",
      "CONTINUAR_CONTAGEM",
    ].includes(inventario.proxima_acao)
  ) {
    return (
      <Button asChild size="sm">
        <Link
          to="/acompanhamento-contagem"
          search={{
            inventario: inventario.id_inventario,
          }}
        >
          <Eye aria-hidden="true" />
          Acompanhar contagem
        </Link>
      </Button>
    );
  }

  if (
    inventario.proxima_acao ===
    "DEFINIR_LOCALIZACOES"
  ) {
    return (
      <Button asChild size="sm">
        <Link
          to="/inventarios/$idInventario/estoque-escopo"
          params={{
            idInventario: String(
              inventario.id_inventario,
            ),
          }}
        >
          <ClipboardList aria-hidden="true" />
          Definir escopo
        </Link>
      </Button>
    );
  }

  if (!tipoOficial && acao === "CONSULTAR_RESULTADO") {
    return (
      <Button asChild size="sm" variant="outline">
        <Link to="/historico" search={{ inventario: inventario.id_inventario, aba: "visao-geral" }}>
          <BarChart3 aria-hidden="true" />
          Ver resultado
        </Link>
      </Button>
    );
  }

  return (
    <Button asChild size="sm" variant="outline">
      <Link
        to="/inventarios/$idInventario"
        params={{
          idInventario: String(
            inventario.id_inventario,
          ),
        }}
      >
        <Eye aria-hidden="true" />
        {rotuloProximaAcao(
          inventario.proxima_acao,
        )}
      </Link>
    </Button>
  );
}

function gerarProximoCodigoInventario(inventarios: InventarioResumo[]) {
  const ano = new Date().getFullYear();
  const prefixo = `INV-${ano}-`;
  let maiorSequencia = 0;

  for (const inventario of inventarios) {
    if (!inventario.codigo_inventario.startsWith(prefixo)) {
      continue;
    }

    const sequencia = Number(
      inventario.codigo_inventario.slice(prefixo.length),
    );

    if (Number.isInteger(sequencia) && sequencia > maiorSequencia) {
      maiorSequencia = sequencia;
    }
  }

  return `${prefixo}${String(maiorSequencia + 1).padStart(3, "0")}`;
}

function Campo({ label, children }: { label: string; children: ReactNode }) {
  return (
    <label className="space-y-1.5">
      <span className="text-sm font-medium text-foreground">{label}</span>
      {children}
    </label>
  );
}

function Resumo({
  titulo,
  valor,
  destaque = false,
  ativo = false,
  onClick,
}: {
  titulo: string;
  valor: number;
  destaque?: boolean;
  ativo?: boolean;
  onClick?: () => void;
}) {
  const classeCard = [
    "w-full rounded-lg border p-4 text-left shadow-xs transition-all",

    ativo
      ? "border-primary bg-primary/5 ring-1 ring-primary/20"
      : destaque
        ? "border-amber-400 bg-amber-50/60 dark:bg-amber-950/20"
        : "border-border bg-card",

    onClick
      ? "cursor-pointer hover:-translate-y-0.5 hover:border-primary/70 hover:shadow-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
      : "",
  ]
    .filter(Boolean)
    .join(" ");

  const classeTitulo = ativo
    ? "text-sm font-medium text-primary"
    : destaque
      ? "text-sm text-amber-700 dark:text-amber-300"
      : "text-sm text-muted-foreground";

  const classeValor = ativo
    ? "text-primary"
    : destaque
      ? "text-amber-700 dark:text-amber-300"
      : "text-primary";

  const conteudo = (
    <>
      <div className={classeTitulo}>
        {titulo}
      </div>

      <div
        className={`mt-1 text-2xl font-bold ${classeValor}`}
      >
        {valor}
      </div>

      {onClick && (
        <div className="mt-2 text-xs text-muted-foreground">
          {ativo ? "Filtro aplicado" : "Clique para filtrar"}
        </div>
      )}
    </>
  );

  if (onClick) {
    return (
      <button
        type="button"
        className={classeCard}
        onClick={onClick}
        aria-pressed={ativo}
      >
        {conteudo}
      </button>
    );
  }

  return (
    <div className={classeCard}>
      {conteudo}
    </div>
  );
}

