  codigo_inventario: string;
  tipo: TipoInventario;
  cliente_id: string;
  cliente: string;
  descricao: string;
  armazem: string;
}

const formularioInicial: NovoInventarioForm = {
  codigo_inventario: "",
  tipo: "ROTATIVO",
  cliente_id: "",
  cliente: "",
  descricao: "",
  armazem: "",
};

const inputClass =
  "h-10 w-full rounded-md border border-input bg-background px-3 text-sm outline-none transition-colors focus:border-primary focus:ring-1 focus:ring-primary disabled:cursor-not-allowed disabled:opacity-60";

function ControleInventariosPage() {
  const usuarioAtual = obterUsuarioSalvo();

  const permissoesEfetivasUsuario = new Set(
    (usuarioAtual?.permissoes ?? [])
      .map((permissao) =>
        typeof permissao === "string"
          ? permissao
          : permissao.codigo,
      )
      .filter(Boolean),
  );

  const podeExecutarContagemUsuario =
    permissoesEfetivasUsuario.has("CONTAGEM_EXECUTAR") &&
    ![
      "ANALISE_VISUALIZAR",
      "CONFIGURACAO_EDITAR",
      "CONFIGURACAO_VISUALIZAR",
      "GESTOR_DECIDIR",
      "INVENTARIO_CRIAR",
      "INVENTARIO_FINALIZAR",
      "INVENTARIO_ROTATIVO_DECIDIR",
      "PLANO_ACAO_GERENCIAR",
      "PLANO_ACAO_VISUALIZAR",
      "RODADA_GERAR",
      "USUARIO_GERENCIAR",
    ].some((permissao) =>
      permissoesEfetivasUsuario.has(permissao),
    );

  const navigate = useNavigate();

  const [inventarios, setInventarios] = useState<InventarioResumo[]>([]);
  // ESTADO_PAGINACAO_CENTRAL_SGI_V1
  const [inventariosAtivos, setInventariosAtivos] = useState<InventarioResumo[]>([]);
  const [statusDisponiveis, setStatusDisponiveis] = useState<string[]>([]);
  const [clientesFiltro, setClientesFiltro] = useState<Array<{ id: number; nome: string }>>([]);
  const [fasesDisponiveis, setFasesDisponiveis] = useState<string[]>([]);
  const [totalRegistros, setTotalRegistros] = useState(0);
  const [totalPaginas, setTotalPaginas] = useState(1);
  const [proximoCodigo, setProximoCodigo] = useState("");
  const [totais, setTotais] = useState({
    preparacao: 0,
    execucao: 0,
    aguardandoDecisao: 0,
    recontagem: 0,
    prontoFinalizar: 0,
    encerrados: 0,
  });
  const [clientesDisponiveis, setClientesDisponiveis] = useState<
    ClienteDisponivelInventario[]
  >([]);
  const [carregandoClientes, setCarregandoClientes] = useState(false);
  const [carregando, setCarregando] = useState(true);
  const [atualizando, setAtualizando] = useState(false);
  const [erro, setErro] = useState<string | null>(null);

  const [pesquisa, setPesquisa] = useState("");
  const [tipo, setTipo] = useState<FiltroTipo>("TODOS");
  const [status, setStatus] = useState("TODOS");
  const [fase, setFase] = useState("ATIVAS");

  const [clienteFiltro, setClienteFiltro] = useState("");

  const [pendenciasFiltro, setPendenciasFiltro] =
    useState<FiltroPendencias>("TODAS");

  const [periodoFiltro, setPeriodoFiltro] =
    useState<FiltroPeriodo>("QUALQUER");

  const [dataInicial, setDataInicial] = useState("");
  const [dataFinal, setDataFinal] = useState("");

  const [paginaAtual, setPaginaAtual] = useState(1);
  const [itensPorPagina, setItensPorPagina] = useState(25);

  const [modalAberto, setModalAberto] = useState(false);
  const [salvando, setSalvando] = useState(false);
  const [erroFormulario, setErroFormulario] = useState<string | null>(null);
  const [sucesso, setSucesso] = useState<string | null>(null);

  const [formulario, setFormulario] =
    useState<NovoInventarioForm>(formularioInicial);

  const [cicloRotativo, setCicloRotativo] = useState<CicloRotativo | null>(
    null,
  );

  const [consultandoCiclo, setConsultandoCiclo] = useState(false);

  const [abrindoCiclo, setAbrindoCiclo] = useState(false);

  const [erroCiclo, setErroCiclo] = useState<string | null>(null);

  const [universoRotativo, setUniversoRotativo] =
    useState<UniversoRotativoStatus | null>(null);

  const [consultandoUniverso, setConsultandoUniverso] = useState(false);

  const [erroUniverso, setErroUniverso] = useState<string | null>(null);

  const [sincronizandoUniverso, setSincronizandoUniverso] = useState(false);

  async function carregarCicloRotativoAtual(
    clienteId: number,
    armazem: string,
  ) {
    setConsultandoCiclo(true);
    setErroCiclo(null);

    try {
      const resposta = await consultarCicloRotativoAtual(clienteId, armazem);

      setCicloRotativo(resposta.possui_ciclo_aberto ? resposta.ciclo : null);
    } catch (falha: unknown) {
      setCicloRotativo(null);

      setErroCiclo(
        falha instanceof Error
          ? falha.message
          : "Não foi possível consultar o ciclo rotativo.",
      );
    } finally {
      setConsultandoCiclo(false);
    }
  }

  async function carregarStatusUniversoRotativo(
    clienteId: number,
    armazem: string,
  ) {
    setConsultandoUniverso(true);
    setErroUniverso(null);

    try {
      const resposta = await consultarStatusUniversoRotativo(
        clienteId,
        armazem,
      );

      setUniversoRotativo(resposta);
    } catch (falha: unknown) {
      setUniversoRotativo(null);

      setErroUniverso(
        falha instanceof Error
          ? falha.message
          : "N?o foi poss?vel consultar o universo rotativo.",
      );
    } finally {
      setConsultandoUniverso(false);
    }
  }

  const carregarInventarios = useCallback(async (
    silencioso = false,
    signal?: AbortSignal,
  ) => {
    if (silencioso) setAtualizando(true);
    else setCarregando(true);

    try {
      const dados = await listarInventariosCentral({
        pagina: paginaAtual,
        por_pagina: itensPorPagina,
        pesquisa: pesquisa.trim() || undefined,
        tipo: tipo === "TODOS" ? undefined : tipo,
        status: status === "TODOS" ? undefined : status,
        cliente_id: clienteFiltro ? Number(clienteFiltro) : undefined,
        fase,
        pendencias: pendenciasFiltro,
        periodo: periodoFiltro,
        data_inicial: dataInicial || undefined,
        data_final: dataFinal || undefined,
      }, signal);

      setInventarios(dados.itens);
      setInventariosAtivos(dados.inventarios_ativos);
      setStatusDisponiveis(dados.status_disponiveis);
      setClientesFiltro(dados.clientes_filtro);
      setFasesDisponiveis(dados.fases_disponiveis);
      setTotalRegistros(dados.total_registros);
      setTotalPaginas(dados.total_paginas);
      setProximoCodigo(dados.proximo_codigo);
      setTotais({
        preparacao: dados.totais.preparacao,
        execucao: dados.totais.execucao,
        aguardandoDecisao: dados.totais.aguardando_decisao,
        recontagem: dados.totais.recontagem,
        prontoFinalizar: dados.totais.pronto_finalizar,
        encerrados: dados.totais.encerrados,
      });
      setPaginaAtual((atual) => atual === dados.pagina ? atual : dados.pagina);
      setErro(null);
    } catch (falha: unknown) {
      if (falha instanceof DOMException && falha.name === "AbortError") return;
      setErro(falha instanceof Error ? falha.message : "Não foi possível carregar os inventários.");
    } finally {
      if (!signal?.aborted) {
        setCarregando(false);
        setAtualizando(false);
      }
    }
  }, [
    paginaAtual, itensPorPagina, pesquisa, tipo, status, fase,
    clienteFiltro, pendenciasFiltro, periodoFiltro, dataInicial, dataFinal,
  ]);

  const carregarClientes = useCallback(async () => {
    setCarregandoClientes(true);

    try {
      const dados = await listarClientesDisponiveis();
      setClientesDisponiveis(dados);
    } catch (falha: unknown) {
      setErroFormulario(
        falha instanceof Error
          ? falha.message
          : "N?o foi poss?vel carregar os clientes.",
      );
    } finally {
      setCarregandoClientes(false);
    }
  }, []);

  useEffect(() => {
    void carregarClientes();
  }, [carregarClientes]);


  const filtrosAtivos = useMemo(() => {
    const ativos: Array<{
      chave: string;
      rotulo: string;
      limpar: () => void;
    }> = [];

    const formatarDataFiltro = (
      valor: string,
    ) => {
      if (!valor) {
        return "";
      }

      const partes = valor.split("-");

      if (partes.length !== 3) {
        return valor;
      }

      const [ano, mes, dia] = partes;

      return `${dia}/${mes}/${ano}`;
    };

    if (clienteFiltro) {
      const clienteSelecionado =
        clientesFiltro.find(
          (cliente) =>
            String(cliente.id) ===
            clienteFiltro,
        );

      ativos.push({
        chave: "cliente",
        rotulo:
          clienteSelecionado?.nome ??
          `Cliente #${clienteFiltro}`,
        limpar: () => {
          setClienteFiltro("");
        },
      });
    }

    if (tipo !== "TODOS") {
      ativos.push({
        chave: "tipo",
        rotulo:
          tipo === "OFICIAL"
            ? "Oficial"
            : "Rotativo",
        limpar: () => {
          setTipo("TODOS");
        },
      });
    }

    if (fase !== "ATIVAS") {
      const rotulosFase: Record<
        string,
        string
      > = {
        TODAS: "Todas as fases",
        EM_EXECUCAO:
          "Em execu\u00e7\u00e3o",
        AGUARDANDO_DECISAO_GERAL:
          "Aguardando decis\u00e3o",
        ENCERRADOS:
          "Encerrados",
      };

      ativos.push({
        chave: "fase",
        rotulo:
          rotulosFase[fase] ??
          rotuloFaseFiltro(fase),
        limpar: () => {
          setFase("ATIVAS");
        },
      });
    }

    if (
      pendenciasFiltro !== "TODAS"
    ) {
      ativos.push({
        chave: "pendencias",
        rotulo:
          pendenciasFiltro ===
          "COM_PENDENCIAS"
            ? "Com pend\u00eancias"
            : "Sem pend\u00eancias",
        limpar: () => {
          setPendenciasFiltro("TODAS");
        },
      });
    }

    if (
      periodoFiltro !== "QUALQUER"
    ) {
      let rotuloPeriodo =
        "Per\u00edodo";

      switch (periodoFiltro) {
        case "HOJE":
          rotuloPeriodo = "Hoje";
          break;

        case "ULTIMOS_7_DIAS":
          rotuloPeriodo =
            "\u00daltimos 7 dias";
          break;

        case "ULTIMOS_30_DIAS":
          rotuloPeriodo =
            "\u00daltimos 30 dias";
          break;

        case "ESTE_MES":
          rotuloPeriodo =
            "Este m\u00eas";
          break;

        case "PERSONALIZADO": {
          const inicio =
            formatarDataFiltro(
              dataInicial,
            );

          const fim =
            formatarDataFiltro(
              dataFinal,
            );

          if (inicio && fim) {
            rotuloPeriodo =
              `${inicio} at\u00e9 ${fim}`;
          } else if (inicio) {
            rotuloPeriodo =
              `A partir de ${inicio}`;
          } else if (fim) {
            rotuloPeriodo =
              `At\u00e9 ${fim}`;
          } else {
            rotuloPeriodo =
              "Per\u00edodo personalizado";
          }

          break;
        }

        default:
          break;
      }

      ativos.push({
        chave: "periodo",
        rotulo: rotuloPeriodo,
        limpar: () => {
          setPeriodoFiltro(
            "QUALQUER",
          );
          setDataInicial("");
          setDataFinal("");
        },
      });
    }

    return ativos;
  }, [
    clienteFiltro,
    clientesFiltro,
    tipo,
    fase,
    pendenciasFiltro,
    periodoFiltro,
    dataInicial,
    dataFinal,
  ]);

  const paginaExibida = Math.min(paginaAtual, totalPaginas);
  const indiceInicial = (paginaExibida - 1) * itensPorPagina;
  const inventariosPaginados = inventarios;
  const primeiroRegistro = totalRegistros === 0 ? 0 : indiceInicial + 1;
  const ultimoRegistro = Math.min(indiceInicial + inventarios.length, totalRegistros);

  useEffect(() => {
    setPaginaAtual(1);
  }, [
    pesquisa, tipo, status, fase, clienteFiltro, pendenciasFiltro,
    periodoFiltro, dataInicial, dataFinal, itensPorPagina,
  ]);

  useEffect(() => {
    const controller = new AbortController();
    const atraso = pesquisa.trim() ? 300 : 0;
    const timer = window.setTimeout(() => {
      void carregarInventarios(false, controller.signal);
    }, atraso);

    return () => {
      window.clearTimeout(timer);
      controller.abort();
    };
  }, [carregarInventarios]);

  const inventariosAtivosNoArmazem = useMemo(() => {
    const armazemSelecionado = normalizarTexto(formulario.armazem);

    if (!armazemSelecionado) {
      return [];
    }

    return inventariosAtivos.filter((inventario) => {
      const mesmoArmazem =
        normalizarTexto(inventario.armazem) === armazemSelecionado;

      const statusNormalizado = normalizarTexto(inventario.status);

      const inventarioAtivo =
        !STATUS_INVENTARIO_TERMINAIS.has(statusNormalizado);

      return mesmoArmazem && inventarioAtivo;
    });
  }, [formulario.armazem, inventariosAtivos]);

  const inventarioAtivoNoArmazem = inventariosAtivosNoArmazem[0] ?? null;

  function abrirNovoInventario() {
    setFormulario({
      ...formularioInicial,
      codigo_inventario: proximoCodigo,
    });

    setErroFormulario(null);
    setSucesso(null);
    setModalAberto(true);

    if (clientesDisponiveis.length === 0) {
      void carregarClientes();
    }
  }

  useEffect(() => {
    if (!modalAberto) {
      return;
    }

    if (formulario.tipo !== "ROTATIVO") {
      setCicloRotativo(null);
      setErroCiclo(null);
      setConsultandoCiclo(false);

      setUniversoRotativo(null);
      setErroUniverso(null);
      setConsultandoUniverso(false);

      return;
    }

    const clienteId = Number(formulario.cliente_id);

    const armazem = formulario.armazem.trim();

    if (!Number.isInteger(clienteId) || clienteId <= 0 || !armazem) {
      setCicloRotativo(null);
      setErroCiclo(null);

      setUniversoRotativo(null);
      setErroUniverso(null);

      return;
    }

    void carregarCicloRotativoAtual(clienteId, armazem);

    void carregarStatusUniversoRotativo(clienteId, armazem);
  }, [modalAberto, formulario.tipo, formulario.cliente_id, formulario.armazem]);

  function fecharModal() {
    if (salvando) return;

    setModalAberto(false);
    setErroFormulario(null);
  }

  function atualizarCampo<K extends keyof NovoInventarioForm>(
    campo: K,
    valor: NovoInventarioForm[K],
  ) {
    setFormulario((anterior) => ({
      ...anterior,
      [campo]: valor,
    }));
  }

  async function sincronizarUniversoDoFormulario() {
    const clienteId = Number(formulario.cliente_id);

    const armazem = formulario.armazem.trim().toUpperCase();

    if (!Number.isInteger(clienteId) || clienteId <= 0 || !armazem) {
      setErroUniverso("Selecione um cliente antes de configurar o universo.");
      return;
    }

    setSincronizandoUniverso(true);
    setErroUniverso(null);
    setErroCiclo(null);

    try {
      await configurarUniversoRotativo({
        cliente_id: clienteId,
        armazem,
      });

      await carregarStatusUniversoRotativo(clienteId, armazem);
    } catch (falha: unknown) {
      setErroUniverso(
        falha instanceof Error
          ? falha.message
          : "Não foi possível sincronizar o universo rotativo.",
      );
    } finally {
      setSincronizandoUniverso(false);
    }
  }

  async function abrirCicloDoFormulario() {
    const clienteId = Number(formulario.cliente_id);

    const armazem = formulario.armazem.trim().toUpperCase();

    if (!Number.isInteger(clienteId) || clienteId <= 0 || !armazem) {
      setErroCiclo("Selecione um cliente antes de abrir o ciclo.");
      return;
    }

    if (consultandoUniverso || !universoRotativo) {
      setErroCiclo(
        "Aguarde a consulta do universo rotativo antes de abrir o ciclo.",
      );
      return;
    }

    if (!universoRotativo.configurado) {
      setErroCiclo("Configure o universo rotativo antes de abrir o ciclo.");
      return;
    }

    if (!universoRotativo.sincronizado) {
      setErroCiclo(
        `O universo rotativo possui ${
          universoRotativo.total_novas_localizacoes
        } nova(s) localização(ões). Sincronize o universo antes de abrir o ciclo.`,
      );
      return;
    }

    setAbrindoCiclo(true);
    setErroCiclo(null);

    try {
      await abrirCicloRotativo({
        cliente_id: clienteId,
        armazem,
      });

      await carregarCicloRotativoAtual(clienteId, armazem);

      await carregarStatusUniversoRotativo(clienteId, armazem);
    } catch (falha: unknown) {
      setErroCiclo(
        falha instanceof Error
          ? falha.message
          : "Não foi possível abrir o ciclo rotativo.",
      );
    } finally {
      setAbrindoCiclo(false);
    }
  }

  async function salvarInventario(evento: FormEvent<HTMLFormElement>) {
    evento.preventDefault();

    setErroFormulario(null);
    setSucesso(null);

    const clienteId = Number(formulario.cliente_id);

    if (!Number.isInteger(clienteId) || clienteId <= 0) {
      setErroFormulario("Selecione um cliente.");
      return;
    }

    if (!formulario.cliente.trim()) {
      setErroFormulario("Selecione um cliente.");
      return;
    }

    if (!formulario.armazem.trim()) {
      setErroFormulario("O cliente selecionado não possui armazém válido.");
      return;
    }

    if (inventarioAtivoNoArmazem) {
      setErroFormulario(
        `O armazém ${formulario.armazem.trim().toUpperCase()} já possui o inventário ${
          inventarioAtivoNoArmazem.codigo_inventario
        } em andamento, com status ${
          inventarioAtivoNoArmazem.status
        }. Finalize ou cancele esse inventário antes de criar outro.`,
      );
      return;
    }

    if (formulario.tipo === "ROTATIVO" && !cicloRotativo) {
      setErroFormulario("Inventario ROTATIVO exige um ciclo rotativo aberto.");
      return;
    }

    const entrada: InventarioCriacaoEntrada = {
      codigo_inventario: formulario.codigo_inventario.trim(),
