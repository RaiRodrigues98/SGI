type Focus = { position: [number, number, number]; target: [number, number, number] } | null;

type FiltroMapa =
  | "todas"
  | "estoque"
  | "livres"
  | "divergencias"
  | "recontagem"
  | "top20";


function formatarNumeroEstoque(
  valor: number,
) {
  return valor.toLocaleString(
    "pt-BR",
    {
      maximumFractionDigits: 3,
    },
  );
}


function formatarValidadeEstoque(
  valor: string | null,
) {
  if (!valor) {
    return "?";
  }

  const correspondencia =
    valor.match(
      /^(\d{4})-(\d{2})-(\d{2})/,
    );

  if (!correspondencia) {
    return valor;
  }

  const [, ano, mes, dia] =
    correspondencia;

  return `${dia}/${mes}/${ano}`;
}



function MapaEstoque3D() {
  const damage = useMemo(() => getDamageArea(), []);

  const [locations, setLocations] =
    useState<WarehouseLocation[]>([]);

  const [
    locationsInventario,
    setLocationsInventario,
  ] = useState<WarehouseLocation[]>([]);

  const [
    locationsDivergencia,
    setLocationsDivergencia,
  ] = useState<WarehouseLocation[]>([]);

  const [
    tipoVisualizacao,
    setTipoVisualizacao,
  ] = useState<WarehouseMapViewType>(
    "estoque-atual",
  );

  const [filtro, setFiltro] =
    useState<FiltroMapa>("todas");

  const [
    tipoInventario,
    setTipoInventario,
  ] = useState<
    "ROTATIVO" | "OFICIAL" | null
  >(null);


  const [
    armazemMapa,
    setArmazemMapa,
  ] = useState<string>(
    "",
  );


  const [
    localizacoesTop20,
    setLocalizacoesTop20,
  ] = useState<string[]>(
    [],
  );


  const [
    top20Detalhes,
    setTop20Detalhes,
  ] = useState<WarehouseTop20Detail[]>(
    [],
  );


  const [
    clienteInventarioId,
    setClienteInventarioId,
  ] = useState<number | null>(
    null,
  );


  const [
    clienteSelecionado,
    setClienteSelecionado,
  ] = useState<string>(
    "todos",
  );

  const [carregandoDados, setCarregandoDados] =
    useState(true);

  const [erroDados, setErroDados] =
    useState<string | null>(null);


  const [
    avisoDivergencias,
    setAvisoDivergencias,
  ] = useState<string | null>(null);

  const [
    snapshotDisponivel,
    setSnapshotDisponivel,
  ] = useState(false);

  const [
    avisoSnapshot,
    setAvisoSnapshot,
  ] = useState<string | null>(null);

  const [selected, setSelected] = useState<WarehouseLocation | null>(null);

  const [
    itensPainelAberto,
    setItensPainelAberto,
  ] = useState(false);


  const [
    pesquisaItensPainel,
    setPesquisaItensPainel,
  ] = useState("");
  const [damageSelected, setDamageSelected] = useState(false);
  const [highlightedCode, setHighlightedCode] = useState<string | null>(null);
  const [focus, setFocus] = useState<Focus>(null);
  const [feedback, setFeedback] = useState<{ ok: boolean; message: string } | null>(null);

  // RESET_ITENS_PAINEL_SELECAO
  useEffect(() => {
    setItensPainelAberto(
      false,
    );

    setPesquisaItensPainel(
      "",
    );
  }, [
    selected?.code,
    tipoVisualizacao,
  ]);


  useEffect(() => {
    let ativo = true;

    async function carregarEstoqueReal() {
      const idInventario =
        obterInventarioAtual();

      if (!idInventario) {
        if (ativo) {
          setLocations([]);
          setArmazemMapa("");
          setTipoInventario(null);
          setClienteInventarioId(null);
          setLocalizacoesTop20([]);
                  setTop20Detalhes([]);



          setErroDados(
            "Selecione um inventário antes de abrir o Mapa 3D.",
          );
          setCarregandoDados(false);
        }

        return;
      }

      setCarregandoDados(true);
      setErroDados(null);

      try {
        const resposta =
          await buscarMapaEstoqueReal(
            idInventario,
          );

        if (!ativo) {
          return;
        }

        setArmazemMapa(
          resposta.armazem,
        );

        setTipoInventario(
          resposta.tipoInventario,
        );


        setClienteInventarioId(
          resposta.clienteInventarioId,
        );
        /*
         * Top 20 do Estoque do Armazem e carregado
         * pelo cliente selecionado no filtro.
         */
        setLocalizacoesTop20([]);
        setTop20Detalhes([]);




        setLocations(
          resposta.visoes.estoqueAtual,
        );

        setLocationsInventario(
          resposta.visoes.estoqueInventario,
        );

        setLocationsDivergencia(
          resposta.visoes.divergencia,
        );

        setSnapshotDisponivel(
          resposta.snapshotDisponivel,
        );

        setAvisoSnapshot(
          resposta.avisoSnapshot,
        );


        setAvisoDivergencias(
          resposta.avisoDivergencias,
        );
      } catch (erro) {
        if (!ativo) {
          return;
        }

        setLocations([]);
        setArmazemMapa("");
        setLocationsInventario([]);
        setLocationsDivergencia([]);
        setLocalizacoesTop20([]);
        setTop20Detalhes([]);


        setSnapshotDisponivel(false);
        setAvisoSnapshot(null);
        setErroDados(
          erro instanceof Error
            ? erro.message
            : "Não foi possível carregar o estoque real.",
        );
      } finally {
        if (ativo) {
          setCarregandoDados(false);
        }
      }
    }

    void carregarEstoqueReal();

    return () => {
      ativo = false;
    };
  }, []);

  // TOP20_DINAMICO_CLIENTE_ARMAZEM
  useEffect(() => {
    let ativo = true;

    if (
      tipoVisualizacao !==
        "estoque-atual" ||
      clienteSelecionado ===
        "todos"
    ) {
      setLocalizacoesTop20([]);
      setTop20Detalhes([]);

      return () => {
        ativo = false;
      };
    }

    const clienteId =
      Number(
        clienteSelecionado,
      );

    if (
      !Number.isInteger(
        clienteId,
      ) ||
      clienteId <= 0 ||
      !armazemMapa
    ) {
      setLocalizacoesTop20([]);
      setTop20Detalhes([]);

      return () => {
        ativo = false;
      };
    }

    /*
     * Limpa imediatamente o ranking do cliente anterior
     * para evitar exibicao de dados cruzados.
     */
    setLocalizacoesTop20([]);
    setTop20Detalhes([]);

    void (
      async () => {
        const resposta =
          await buscarTop20ArmazemCliente(
            clienteId,
            armazemMapa,
            20,
          );

        if (
          !ativo
        ) {
          return;
        }

        setLocalizacoesTop20(
          resposta.localizacoesTop20,
        );

        setTop20Detalhes(
          resposta.top20Detalhes,
        );
      }
    )();

    return () => {
      ativo = false;
    };
  }, [
    armazemMapa,
    clienteSelecionado,
    tipoVisualizacao,
  ]);


  const clientesDisponiveis =
    useMemo(() => {
      const clientes =
        new Map<
          number,
          string
        >();


      for (
        const location
        of locations
      ) {
        for (
          const item
          of location.itensEstoque ??
          []
        ) {
          clientes.set(
            item.clienteId,
            item.cliente,
          );
        }
      }


      return Array.from(
        clientes.entries(),
      )
        .map(
          ([
            id,
            nome,
          ]) => ({
            id,
            nome,
          }),
        )
        .sort(
          (
            a,
            b,
          ) =>
            a.nome.localeCompare(
              b.nome,
              "pt-BR",
            ),
        );
    }, [
      locations,
    ]);


  const locationsBase =
    useMemo(() => {
      if (
        tipoVisualizacao ===
        "estoque-inventario"
      ) {
        return locationsInventario;
      }

      if (
        tipoVisualizacao ===
        "divergencia"
      ) {
        return locationsDivergencia;
      }

      /*
       * Estoque do Armazém:
       * aplica cliente somente nesta visualização.
       */
      if (
        clienteSelecionado ===
        "todos"
      ) {
        return locations;
      }


      const clienteId =
        Number(
          clienteSelecionado,
        );


      if (
        !Number.isInteger(
          clienteId,
        )
      ) {
        return locations;
      }


      return locations.map(
        (location) => {
          const itens =
            (
              location.itensEstoque ??
              []
            ).filter(
              (item) =>
                item.clienteId ===
                clienteId,
            );


          const quantidade =
            itens.reduce(
              (
                total,
                item,
              ) =>
                total +
                item.quantidade,

              0,
            );


          const primeiro =
            itens[0] ??
            null;


          const produtos =
            new Set(
              itens
                .map(
                  (item) =>
                    item.descricao?.trim() ||
                    item.codigo,
                )
                .filter(
                  Boolean,
                ),
            );


          const lotes =
            new Set(
              itens
                .map(
                  (item) =>
                    item.lote?.trim(),
                )
                .filter(
                  (
                    lote,
                  ): lote is string =>
                    Boolean(
                      lote,
                    ),
                ),
            );


          const status:
            WarehouseLocation["status"] =
              itens.length === 0
                ? "livre"
                : location.status ===
                    "divergencia" ||
                  location.status ===
                    "recontagem"
                  ? location.status
                  : "ocupada";


          return {
            ...location,

            quantidade,

            produto:
              produtos.size === 0
                ? null
                : produtos.size === 1
                  ? (
                      primeiro?.descricao?.trim() ||
                      primeiro?.codigo ||
                      null
                    )
                  : `${produtos.size} itens`,

            lote:
              lotes.size === 0
                ? null
                : lotes.size === 1
                  ? Array.from(
                      lotes,
                    )[0] ??
                    null
                  : "Múltiplos lotes",

            status,

            itensEstoque:
              itens,
          };
        },
      );
    }, [
      clienteSelecionado,
      locations,
      locationsDivergencia,
      locationsInventario,
      tipoVisualizacao,
    ]);


  const resumoVisualizacao =
    useMemo(() => {
      const ocupadas =
        locationsBase.filter(
          (location) =>
            location.quantidade !== 0 ||
            location.produto !== null,
        ).length;

      const divergencias =
        locationsBase.filter(
          (location) =>
            location.status ===
            "divergencia",
        ).length;

      const recontagem =
        locationsBase.filter(
          (location) =>
            location.status ===
            "recontagem",
        ).length;

      return {
        ocupadas,

        livres:
          locationsBase.length -
          ocupadas,

        divergencias,

        recontagem,
      };
    }, [locationsBase]);


  const opcoesStatus =
    useMemo<
      Array<{
        value: FiltroMapa;
        label: string;
      }>
    >(() => {
      /*
       * ESTOQUE DO ARMAZEM
       *
       * O Top 20 pertence ao estoque fisico
       * do cliente usado no ciclo rotativo.
       */
      if (
        tipoVisualizacao ===
        "estoque-atual"
      ) {
        const opcoes: Array<{
          value: FiltroMapa;
          label: string;
        }> = [
          {
            value: "todas",
            label:
              "Todas as posi\u00e7\u00f5es",
          },
          {
            value: "estoque",
            label:
              "Com estoque",
          },
          {
            value: "livres",
            label:
              "Posi\u00e7\u00f5es livres",
          },
        ];

        const clienteId =
          Number(
            clienteSelecionado,
          );

        const top20Permitido =
          Number.isInteger(
            clienteId,
          ) &&
          clienteId > 0 &&
          localizacoesTop20.length >
            0;

        if (
          top20Permitido
        ) {
          opcoes.push({
            value:
              "top20",
            label:
              "Top 20 priorizadas",
          });
        }

        return opcoes;
      }


      /*
       * ESTOQUE DO INVENTARIO
       *
       * Top 20 nao pertence a esta visao.
       */
      if (
        tipoVisualizacao ===
        "estoque-inventario"
      ) {
        if (
          tipoInventario ===
          "ROTATIVO"
        ) {
          return [
            {
              value:
                "estoque",
              label:
                "Localiza\u00e7\u00f5es do invent\u00e1rio",
            },
            {
              value:
                "divergencias",
              label:
                "Com diverg\u00eancia",
            },
          ];
        }

        return [
          {
            value:
              "estoque",
            label:
              "Localiza\u00e7\u00f5es do invent\u00e1rio",
          },
        ];
      }


      /*
       * VISAO DE DIVERGENCIAS
       */
      return [
        {
          value: "todas",
          label:
            "Todas as pend\u00eancias",
        },
        {
          value:
            "divergencias",
          label:
            "Com diverg\u00eancia",
        },
        {
          value:
            "recontagem",
          label:
            "Em recontagem",
        },
      ];
    }, [
      clienteSelecionado,
      localizacoesTop20.length,
      tipoInventario,
      tipoVisualizacao,
    ]);


  // NORMALIZAR_FILTRO_MAPA_INVENTARIO
  useEffect(() => {
    /*
     * ESTOQUE DO INVENTARIO
     */
    if (
      tipoVisualizacao ===
      "estoque-inventario"
    ) {
      if (
        tipoInventario ===
        "ROTATIVO"
      ) {
        if (
          filtro ===
            "estoque" ||
          filtro ===
            "divergencias"
        ) {
          return;
        }
      }

      if (
        filtro !==
        "estoque"
      ) {
        setFiltro(
          "estoque",
        );
      }

      return;
    }


    /*
     * ESTOQUE DO ARMAZEM
     */
    if (
      tipoVisualizacao ===
      "estoque-atual"
    ) {
      const clienteId =
        Number(
          clienteSelecionado,
        );

      const top20Permitido =
          Number.isInteger(
            clienteId,
          ) &&
          clienteId > 0 &&
          localizacoesTop20.length >
            0;

      if (
        filtro ===
          "top20"
      ) {
        if (
          top20Permitido
        ) {
          return;
        }

        setFiltro(
          "todas",
        );

        return;
      }

      if (
        filtro ===
          "todas" ||
        filtro ===
          "estoque" ||
        filtro ===
          "livres"
      ) {
        return;
      }

      setFiltro(
        "todas",
      );

      return;
    }


    /*
     * VISAO DE DIVERGENCIAS
     */
    if (
      filtro ===
        "todas" ||
      filtro ===
        "divergencias" ||
      filtro ===
        "recontagem"
    ) {
      return;
    }

    setFiltro(
      "todas",
    );
  }, [
    clienteSelecionado,
    filtro,
    localizacoesTop20.length,
    tipoInventario,
    tipoVisualizacao,
  ]);


  const localizacoesTop20Set =
    useMemo(
      () =>
        new Set(
          localizacoesTop20.map(
            (
              localizacao,
            ) =>
              normalizeCode(
                localizacao,
              ),
          ),
        ),
      [
        localizacoesTop20,
      ],
    );


  const locationsVisiveis =
    useMemo(() => {
      if (
        filtro ===
        "top20"
      ) {
        return locationsBase.filter(
          (
            location,
          ) =>
            localizacoesTop20Set.has(
              normalizeCode(
                location.code,
              ),
            ),
        );
      }


      if (
        filtro ===
        "estoque"
      ) {
        return locationsBase.filter(
          (
            location,
          ) =>
            location.quantidade !==
              0 ||
            location.produto !==
              null,
        );
      }


      if (
        filtro ===
        "livres"
      ) {
        return locationsBase.filter(
          (
            location,
          ) =>
            location.quantidade ===
              0 &&
            location.produto ===
              null,
        );
      }


      if (
        filtro ===
        "divergencias"
      ) {
        return locationsBase.filter(
          (
            location,
          ) =>
            location.status ===
            "divergencia",
        );
      }


      if (
        filtro ===
        "recontagem"
      ) {
        return locationsBase.filter(
          (
            location,
          ) =>
            location.status ===
            "recontagem",
        );
      }


      return locationsBase;
    }, [
      filtro,
      localizacoesTop20Set,
      locationsBase,
    ]);


  const itensPainelFiltrados =
    useMemo(() => {
      const itens =
        selected?.itensEstoque ??
        [];

      const pesquisa =
        pesquisaItensPainel
          .trim()
          .toLocaleLowerCase(
            "pt-BR",
          );

      if (!pesquisa) {
        return itens;
      }

      return itens.filter(
        (item) => {
          const campos = [
            item.codigo,
            item.descricao ?? "",
            item.lote ?? "",
            item.cliente,
            item.unidade ?? "",
            item.categoria ?? "",
            item.statusEstoque ?? "",
            item.tipoLocalizacao ?? "",
          ];

          return campos.some(
            (campo) =>
              campo
                .toLocaleLowerCase(
                  "pt-BR",
                )
                .includes(
                  pesquisa,
                ),
          );
        },
      );
    }, [
      pesquisaItensPainel,
      selected,
    ]);


  const itensContadosPainelFiltrados =
    useMemo(() => {
      const itens =
        selected?.itensContados ??
        [];

      const pesquisa =
        pesquisaItensPainel
          .trim()
          .toLocaleLowerCase(
            "pt-BR",
          );

      if (!pesquisa) {
        return itens;
      }

      return itens.filter(
        (item) => {
          const campos = [
            item.codigo,
            item.descricao ?? "",
            item.lote ?? "",
            item.status,
          ];

          return campos.some(
            (campo) =>
              campo
                .toLocaleLowerCase(
                  "pt-BR",
                )
                .includes(
                  pesquisa,
                ),
          );
        },
      );
    }, [
      pesquisaItensPainel,
      selected,
    ]);


  const resumoOperacionalEstoqueSelecionado =
    useMemo(() => {
      const itens =
        selected?.itensEstoque ??
        [];

      return itens.reduce(
        (
          resumo,
          item,
        ) => ({
          fisico:
            resumo.fisico +
            item.quantidade,

          reservado:
            resumo.reservado +
            item.reservado,

          bloqueado:
            resumo.bloqueado +
            item.bloqueado,

          disponivel:
            resumo.disponivel +
            item.disponivel,
        }),
        {
          fisico: 0,
          reservado: 0,
          bloqueado: 0,
          disponivel: 0,
        },
      );
    }, [
      selected,
    ]);


  const top20Selecionado =
    useMemo(() => {
      /*
       * O ranking pertence ao Estoque do Armazem
       * e ao cliente atualmente selecionado.
       *
       * top20Detalhes ja e recarregado dinamicamente
       * quando cliente/armazem mudam.
       */
      if (
        !selected ||
        tipoVisualizacao !==
          "estoque-atual" ||
        clienteSelecionado ===
          "todos"
      ) {
        return null;
      }

      const codigoSelecionado =
        normalizeCode(
          selected.code,
        );

      return (
        top20Detalhes.find(
          (
            item,
          ) =>
            normalizeCode(
              item.localizacao,
            ) ===
            codigoSelecionado,
        ) ??
        null
      );
    }, [
      clienteSelecionado,
      selected,
      tipoVisualizacao,
      top20Detalhes,
    ]);


  const resumoContagemSelecionada =
    useMemo(() => {
      const itens =
        selected?.itensContados ??
        [];

      const possuiContagem =
        itens.length > 0;

      const esperado =
        tipoVisualizacao ===
          "estoque-inventario"
          ? selected?.quantidade ??
            0
          : 0;

      const contado =
        itens.reduce(
          (
            total,
            item,
          ) =>
            total +
            item.quantidade,
          0,
        );

      const skus =
        new Set(
          itens
            .map(
              (item) =>
                item.codigo
                  .trim()
                  .toUpperCase(),
            )
            .filter(
              Boolean,
            ),
        ).size;

      const lotes =
        new Set(
          itens
            .map(
              (item) =>
                item.lote
                  ?.trim()
                  .toUpperCase(),
            )
            .filter(
              (
                lote,
              ): lote is string =>
