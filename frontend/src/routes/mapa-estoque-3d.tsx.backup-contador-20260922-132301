                                >
                                  Nenhum item encontrado.
                                </p>
                              </div>
                            ) : (
                              <div
                                className="
                                  mt-3
                                  max-h-[310px]
                                  space-y-2
                                  overflow-y-auto
                                  pr-1
                                "
                              >
                                {itensContadosPainelFiltrados.map(
                                  (
                                    item,
                                    index,
                                  ) => (
                                    <div
                                      key={`${item.codigo}-${item.lote ?? "sem-lote"}-${index}`}
                                      className="
                                        rounded-lg
                                        border
                                        border-border/40
                                        bg-muted/15
                                        p-3
                                      "
                                    >
                                      <div
                                        className="
                                          flex
                                          items-start
                                          justify-between
                                          gap-3
                                        "
                                      >
                                        <div className="min-w-0">
                                          <p
                                            className="
                                              text-[10px]
                                              font-semibold
                                              uppercase
                                              tracking-wide
                                              text-muted-foreground
                                            "
                                          >
                                            C&oacute;digo
                                          </p>

                                          <p
                                            className="
                                              mt-0.5
                                              break-all
                                              text-sm
                                              font-bold
                                              text-foreground
                                            "
                                          >
                                            {
                                              item.codigo
                                            }
                                          </p>
                                        </div>

                                        <div
                                          className="
                                            shrink-0
                                            text-right
                                          "
                                        >
                                          <p
                                            className="
                                              text-[10px]
                                              uppercase
                                              tracking-wide
                                              text-muted-foreground
                                            "
                                          >
                                            Qtd. contada
                                          </p>

                                          <p
                                            className="
                                              mt-0.5
                                              text-sm
                                              font-bold
                                              tabular-nums
                                              text-foreground
                                            "
                                          >
                                            {item.quantidade.toLocaleString(
                                              "pt-BR",
                                            )}
                                          </p>
                                        </div>
                                      </div>


                                      <div className="mt-2">
                                        <p
                                          className="
                                            text-[10px]
                                            uppercase
                                            tracking-wide
                                            text-muted-foreground
                                          "
                                        >
                                          Produto
                                        </p>

                                        <p
                                          className="
                                            mt-0.5
                                            break-words
                                            text-xs
                                            font-medium
                                            leading-5
                                            text-foreground
                                          "
                                        >
                                          {item.descricao?.trim() ||
                                            item.codigo}
                                        </p>
                                      </div>


                                      <div
                                        className="
                                          mt-2
                                          grid
                                          grid-cols-2
                                          gap-3
                                        "
                                      >
                                        <div>
                                          <p
                                            className="
                                              text-[10px]
                                              uppercase
                                              tracking-wide
                                              text-muted-foreground
                                            "
                                          >
                                            Lote
                                          </p>

                                          <p
                                            className="
                                              mt-0.5
                                              break-all
                                              text-xs
                                              font-medium
                                              text-foreground
                                            "
                                          >
                                            {item.lote ??
                                              "Sem lote"}
                                          </p>
                                        </div>

                                        <div>
                                          <p
                                            className="
                                              text-[10px]
                                              uppercase
                                              tracking-wide
                                              text-muted-foreground
                                            "
                                          >
                                            Status
                                          </p>

                                          <p
                                            className="
                                              mt-0.5
                                              break-words
                                              text-xs
                                              font-semibold
                                              text-foreground
                                            "
                                          >
                                            {
                                              item.status
                                            }
                                          </p>
                                        </div>
                                      </div>
                                    </div>
                                  ),
                                )}
                              </div>
                            )}
                          </div>
                        ) : null}
                      </div>
                    </>
                  )}


                  {/* Posicao fisica */}
                  <div className="mt-4">
                    <p
                      className="
                        mb-2
                        text-[10px]
                        font-semibold
                        uppercase
                        tracking-[0.14em]
                        text-muted-foreground
                      "
                    >
                      Posi&ccedil;&atilde;o f&iacute;sica
                    </p>

                    <div
                      className="
                        grid
                        grid-cols-3
                        gap-x-4
                        gap-y-3
                      "
                    >
                      <div>
                        <p className="text-[10px] text-muted-foreground">
                          Rua
                        </p>
                        <p className="text-sm font-semibold">
                          {selected.rua}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] text-muted-foreground">
                          Lado
                        </p>
                        <p className="text-sm font-semibold">
                          {selected.lado ===
                          "impar"
                            ? "\u00cdmpar"
                            : "Par"}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] text-muted-foreground">
                          M&oacute;dulo
                        </p>
                        <p className="text-sm font-semibold tabular-nums">
                          {selected.modulo}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] text-muted-foreground">
                          N&iacute;vel
                        </p>
                        <p className="text-sm font-semibold tabular-nums">
                          {selected.nivel}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] text-muted-foreground">
                          Posi&ccedil;&atilde;o
                        </p>
                        <p className="text-sm font-semibold tabular-nums">
                          {selected.posicao}
                        </p>
                      </div>

                      <div>
                        <p className="text-[10px] text-muted-foreground">
                          Endere&ccedil;o
                        </p>
                        <p
                          className="
                            break-all
                            text-sm
                            font-semibold
                          "
                        >
                          {selected.code}
                        </p>
                      </div>
                    </div>
                  </div>


                  {/* Acoes */}
                  <div
                    className="
                      mt-5
                      flex
                      gap-2
                      border-t
                      border-border/40
                      pt-3
                    "
                  >
                    <button
                      type="button"
                      onClick={() => {
                        focusOn(
                          selected,
                        );
                      }}
                      className="
                        flex-1
                        rounded-lg
                        bg-primary
                        px-3
                        py-2
                        text-xs
                        font-semibold
                        text-primary-foreground
                        transition
                        hover:opacity-90
                      "
                    >
                      Focar posi&ccedil;&atilde;o
                    </button>

                    <button
                      type="button"
                      onClick={
                        handleClear
                      }
                      className="
                        rounded-lg
                        border
                        border-border/50
                        bg-background
                        px-3
                        py-2
                        text-xs
                        font-semibold
                        text-foreground
                        transition
                        hover:bg-muted
                      "
                    >
                      Fechar
                    </button>
                  </div>
                </div>
              </div>
            ) : null}


            {/* Filtros sobre o mapa */}
            <div className="pointer-events-none absolute left-3 top-3 z-20 max-w-[calc(100%-24px)]">
              <div
                className="
                  pointer-events-auto
                  w-fit
                  max-w-full
                  rounded-lg
                  border
                  border-border/20
                  bg-background/80
                  px-3
                  py-2.5
                  shadow-sm
                  backdrop-blur-md
                "
              >
                <div
                  className="
                    grid
                    gap-3
                    xl:grid-cols-[300px_220px_200px_190px]
                    xl:items-end
                  "
                >
                  {/* Localização */}
                  <div className="min-w-0">
                    <p className="mb-1.5 text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">
                      Localização
                    </p>

                    <SearchBar
                      onSearch={handleSearch}
                      onResetCamera={resetCamera}
                      feedback={feedback}
                    />
                  </div>

                  {/* Cliente */}
                  <label className="block">
                    <span className="mb-1.5 block text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">
                      Cliente
                    </span>

                    <select
                      value={
                        tipoVisualizacao ===
                        "estoque-atual"
                          ? clienteSelecionado
                          : "todos"
                      }
                      disabled={
                        tipoVisualizacao !==
                        "estoque-atual"
                      }
                      onChange={(evento) => {
                        setClienteSelecionado(
                          evento.target.value,
                        );

                        setFiltro(
                          "todas",
                        );

                        setFeedback(
                          null,
                        );

                        handleClear();
                      }}
                      className="
                        h-11
                        w-full
                        rounded-lg
                        border
                        border-input
                        bg-background/90
                        px-3
                        text-sm
                        font-medium
                        text-foreground
                        outline-none
                        transition
                        focus:ring-2
                        focus:ring-ring
                      "
                    >
                      <option value="todos">
                        {tipoVisualizacao ===
                        "estoque-atual"
                          ? "Todos os clientes"
                          : "Cliente do inventário"}
                      </option>

                      {tipoVisualizacao ===
                        "estoque-atual" &&
                        clientesDisponiveis.map(
                          (cliente) => (
                            <option
                              key={
                                cliente.id
                              }
                              value={
                                String(
                                  cliente.id,
                                )
                              }
                            >
                              {
                                cliente.nome
                              }
                            </option>
                          ),
                        )}
                    </select>
                  </label>


                  {/* Tipo */}
                  <label className="block">
                    <span className="mb-1.5 block text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">
                      Tipo
                    </span>

                    <select
                      value={tipoVisualizacao}
                      onChange={(evento) => {
                        const novaVisualizacao =
                          evento.target.value as WarehouseMapViewType;

                        setTipoVisualizacao(
                          novaVisualizacao,
                        );

                        setFiltro(
                          novaVisualizacao ===
                            "estoque-inventario"
                            ? "estoque"
                            : "todas",
                        );
                        setFeedback(null);
                        handleClear();
                      }}
                      className="
                        h-11
                        w-full
                        rounded-lg
                        border
                        border-input
                        bg-background/90
                        px-3
                        text-sm
                        font-medium
                        text-foreground
                        outline-none
                        transition
                        focus:ring-2
                        focus:ring-ring
                      "
                    >
                      <option value="estoque-atual">
                        Estoque do Armazém
                      </option>

                      <option
                        value="estoque-inventario"
                        disabled={!snapshotDisponivel}
                      >
                        Estoque inventário
                      </option>
                    </select>
                  </label>

                  {/* Status */}
                  <label className="block">
                    <span className="mb-1.5 block text-[11px] font-semibold uppercase tracking-wide text-muted-foreground">
                      Status
                    </span>

                    <select
                      value={filtro}
                      onChange={(evento) => {
                        setFiltro(
                          evento.target.value as FiltroMapa,
                        );

                        setFeedback(
                          null,
                        );

                        handleClear();
                      }}
                      className="
                        h-11
                        w-full
                        rounded-lg
                        border
                        border-input
                        bg-background/90
                        px-3
                        text-sm
                        font-medium
                        text-foreground
                        outline-none
                        transition
                        focus:ring-2
                        focus:ring-ring
                      "
                    >
                      {opcoesStatus.map(
                        (opcao) => (
                          <option
                            key={
                              opcao.value
                            }
                            value={
                              opcao.value
                            }
                          >
                            {
                              opcao.label
                            }
                          </option>
                        ),
                      )}
                    </select>
                  </label>



                </div>

                {!snapshotDisponivel && avisoSnapshot ? (
                  <p className="mt-2 text-xs text-muted-foreground">
                    Estoque do inventário indisponível para esta consulta.
                  </p>
                ) : null}
              </div>
            </div>

            {/* Legenda dentro do mapa */}
            <div className="pointer-events-none absolute bottom-3 left-3 z-20 max-w-[calc(100%-24px)]">
              <Legend
                tipoVisualizacao={
                  tipoVisualizacao
                }
                tipoInventario={
                  tipoInventario
                }
              />
            </div>

            {/* Ajuda de navegação */}
            <div
              className="
                pointer-events-none
                absolute
                bottom-3
                right-3
                z-20
                hidden
                rounded-lg
                border
                border-border/80
                bg-background/90
                px-3
                py-2
                text-xs
                text-muted-foreground
                shadow-md
                backdrop-blur-md
                2xl:block
              "
            >
              <span className="font-semibold text-foreground">Navegação:</span>{" "}
              arraste para girar • scroll para zoom • clique para selecionar
            </div>
          </div>
        </div>


      </div>
    </main>
  );
}
